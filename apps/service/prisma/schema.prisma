// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model VisitEvent {
  id         BigInt   @id @default(autoincrement())
  visit_id   String   @unique @db.VarChar(50) // no rawat
  event_time DateTime // Waktu REGISTER terjadi di sistem sumber

  // Dimensi Agregasi
  tanggal        DateTime @db.Date // start of day
  jam_registrasi String   @db.VarChar(10) // HH:MM
  poli_id        String   @db.VarChar(20)
  dokter_id      Int

  // Patient essential data - needed for BPJS submission
  // Nullable during migration, but should be populated
  no_rkm_medis  String  @db.VarChar(50)
  nomor_antrean String? @db.VarChar(20)
  // Antrean 
  angka_antrean Int?

  // Snapshot jadwal + kuota dari polling time
  // Contains: jam_praktek, kuota_jkn, sisa_kuota_jkn, kuota_nonjkn, sisa_kuota_nonjkn, estimasi_dilayani
  payload Json?

  // Relasi dari EventTask
  EventTasks EventTask[]

  syncedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  flags     Flag[]

  @@index([event_time])
  @@index([tanggal, poli_id, dokter_id])
}

model EventTask {
  id       BigInt @id @default(autoincrement())
  task_id  Int    @default(0) // "0", "3" ... "7"
  visit_id String @db.VarChar(50) // no rawat

  // Relasi dari VisitEvent
  visit_event_id BigInt
  VisitEvent     VisitEvent @relation(fields: [visit_event_id], references: [id], onDelete: Cascade)

  status              TaskEventStatus @default(FAILED) // "DONE", "FAILED", "SEND"
  event_time          DateTime // Waktu REGISTER terjadi di sistem sumber
  original_event_time DateTime? // Waktu asli dari sumber (jika terjadi clamping)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([visit_event_id, task_id])
  @@index([status, task_id, visit_id])
  @@index([event_time])
}

// Model Karantina jika data cacat atau perlu reprocess
model VisitEventQuarantine {
  id         BigInt   @id @default(autoincrement())
  visit_id   String   @unique @db.VarChar(50) // no rawat
  event_time DateTime // Waktu REGISTER terjadi di sistem sumber

  severity  SeverityLevel @default(LOW) // e.g., "LOW", "MEDIUM", "HIGH"
  reason    Json          @db.Json // Reason for quarantine
  createdAt DateTime      @default(now())
}

// Snapshot jadwal + kuota dari VisitEvent
model DoctorScheduleQuota {
  id BigInt @id @default(autoincrement())

  dokter_id   Int
  poli_id     String @db.VarChar(20)
  nama_dokter String @db.VarChar(100)
  nama_poli   String @db.VarChar(100)

  tanggal DateTime // YYYY-MM-DD 00:00:00

  jam_mulai   String @db.VarChar(10) // HH:MM
  jam_selesai String @db.VarChar(10) // HH:MM

  kuota_jkn Int

  source    String // "BPJS HFIS"
  fetchedAt DateTime // Waktu data diambil dari sistem sumber

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([poli_id, dokter_id, tanggal, jam_mulai])
  @@index([tanggal, poli_id, dokter_id])
}

// Cursor sebagai penanda terakhir sinkronisasi data jadwal + kuota
model VisitEventCursor {
  id         BigInt         @id @default(autoincrement())
  event_type VisitEventType @unique @default(REGISTER) // Jenis event terakhir yang diproses
  event_time DateTime // Waktu REGISTER terjadi di sistem sumber
  createdAt  DateTime       @default(now())
}

// Log proses pengiriman Antrean API BPJS
model VisitEventLog {
  id         BigInt   @id @default(autoincrement())
  visit_id   String   @db.VarChar(50) // no rawat
  task_id    String   @db.VarChar(10) // "1", "3", "4", "5"
  event_time DateTime // Waktu REGISTER terjadi di sistem sumber 

  payload   Json
  http_code Int

  retry_count Int     @default(0)
  last_error  String?

  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  // index
  @@index([visit_id, task_id])
  @@index([sentAt])
}

// Pengecualian POLI
model PoliException {
  id        BigInt    @id @default(autoincrement())
  poli_id   String    @db.VarChar(20)
  nama_poli String    @db.VarChar(100)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([poli_id])
}

// Kategori
model Category {
  id        BigInt    @id @default(autoincrement())
  name      String    @db.VarChar(100)
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
  flags     Flag[]

  @@unique([name])
}

// Flag untuk VisitEvent
// Boleh lebih dari 1 flag
model Flag {
  id          BigInt     @id @default(autoincrement())
  visit_id    String     @db.VarChar(50) // no rawat
  visit_event VisitEvent @relation(fields: [visit_id], references: [visit_id], onDelete: Cascade)

  category_id BigInt
  category    Category @relation(fields: [category_id], references: [id], onDelete: Cascade)

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@unique([visit_id, category_id])
  @@index([category_id])
}

// Snapshot untuk data pasien registrasi
model RegistrationSnapshot {
  id                  BigInt   @id @default(autoincrement())
  visit_id            String   @unique @db.VarChar(50) // no rawat
  event_time          String // Waktu REGISTER terjadi di sistem sumber atau waktu registrasi (UNIX format)
  event_time_datetime DateTime @db.Date // Digunakan untuk query dan sorting
  no_rkm_medis        String   @db.VarChar(50)
  sumber_data         String   @db.VarChar(100) // e.g., "SIRS", "BPJS HFIS"
  tanggal             DateTime @db.Date // tanggal periksa
  kodedokter          Int // kode dokter
  kodepoli            String   @db.VarChar(20)
  status_peserta      Boolean  @default(false) // Apakah pasien peserta BPJS
  status_kunjungan    Boolean  @default(false) // Apakah peserta sudah berkunjung/selesai pemeriksaan

  payload   Json      @db.Json // Snapshot data registrasi
  fetchedAt DateTime // Waktu data diambil dari sistem sumber
  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt

  @@index([visit_id])
  @@index([event_time])
  @@index([event_time_datetime])
  @@index([tanggal])
}

enum VisitEventType {
  POLLER
  REGISTER
  CHECKIN
  START
  FINISH
}

enum TaskStatus {
  DRAFT
  READY_BPJS
  BLOCKED_BPJS
  SENT_BPJS
  FAILED_BPJS
}

enum SeverityLevel {
  LOW
  MEDIUM
  HIGH
}

enum Status {
  PENDING
  SEND
  FAILED
}

enum TaskEventStatus {
  DONE
  FAILED
  SEND
}

model User {
  id         BigInt   @id @default(autoincrement())
  username   String   @unique @db.VarChar(100)
  password   String   @db.VarChar(255)
  name       String   @db.VarChar(100)
  role       String   @default("user") @db.VarChar(50)
  permissions Json    @default("[]") @db.Json // Array of allowed routes
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime? @updatedAt

  @@index([username])
}
